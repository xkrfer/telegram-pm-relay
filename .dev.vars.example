# Local Development Environment Variables
# Copy this file to .dev.vars and fill in actual values
# .dev.vars is ignored by .gitignore and won't be committed

# Telegram Bot Configuration
BOT_TOKEN=your-telegram-bot-token
BOT_SECRET=your-webhook-secret
ADMIN_UID=your-telegram-user-id

# AI verification uses the AI binding configured in wrangler.jsonc.
# No external API URL or API key is required.
